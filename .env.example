# ============================================================
# ACOUNTING — Environment Configuration Template
# Salin file ini menjadi .env dan isi sesuai kebutuhan Anda.
# JANGAN commit file .env ke repository!
# ============================================================

# === Aplikasi ===
APP_ENV=development
# development | production
# Pada mode development: error ditampilkan, dev badges muncul
# Pada mode production:  error disembunyikan, log ke file

BASEURL=http://localhost/acounting/acounting/public
# Sesuaikan dengan URL instalasi Anda

# === Database MySQL ===
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=acounting_db

# === Email SMTP (untuk verifikasi email) ===
# Gunakan Mailtrap untuk testing: https://mailtrap.io
SMTP_HOST=smtp.mailtrap.io
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_PORT=2525

# === WhatsApp API (untuk OTP) ===
# Dukung: https://fonnte.com atau API WhatsApp lainnya
WA_API_KEY=your_wa_api_key_here
WA_API_URL=https://api.fonnte.com/send

# === AI Assistant ===
# Provider default jika konfigurasi database belum ada: mock | gemini
# Provider lain (Relink, OpenAI, DeepSeek, Claude, OpenRouter, custom) diatur
# dari menu Pengaturan Aca dan disimpan terenkripsi di database.
AI_PROVIDER=mock
# Fallback environment per provider (opsional; database lebih diutamakan).
# Gemini: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here
RELINK_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_AI_API_KEY=
# Model default. Admin dapat menggantinya dari menu Pengaturan Aca.
AI_MODEL=gemini-flash-lite-latest
AI_TEMPERATURE=0.30
AI_MAX_OUTPUT_TOKENS=800
# Kunci enkripsi API key yang disimpan di database (AES-256-GCM).
# WAJIB berbeda dari kredensial database dan TIDAK boleh di-commit.
# Buat dengan: php -r "echo base64_encode(random_bytes(32));"
AI_ENCRYPTION_KEY=
